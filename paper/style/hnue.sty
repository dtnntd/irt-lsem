% ============================================================================
% hnue.sty — HNUE Journal of Science compliance package
%
% Reusable macros + section heading specs aligned with HNUE format:
%   (theo "Mau bao cao Tieng Viet.docx" của Tạp chí)
%   - paper 19x27 cm, margins top 2.5 / bottom 2 / inside 3 / outside 1 cm
%     (handled in main.tex geometry)
%   - Times New Roman 11pt body, single line spacing (main.tex)
%   - section headings 14pt / 12pt / 11pt bold
%   - table caption above, figure caption below, both bold italic:
%     "Bảng 1. ...", "Hình 1. ..." 
%
% This file deliberately contains NO documentclass / geometry / babel.
% Those belong to main.tex so the package is loadable for other HNUE papers.
% ============================================================================
\ProvidesPackage{style/hnue}[2026/05/28 HNUE Journal of Science format helpers]

\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{etoolbox}

% --- Heading levels per HNUE spec --------------------------------------------
\titleformat{\section}
  {\fontsize{14}{16}\bfseries}{\thesection.}{0.5em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}

\titleformat{\subsection}
  {\fontsize{12}{14}\bfseries}{\thesubsection.}{0.5em}{}
\titlespacing*{\subsection}{0pt}{6pt}{6pt}

\titleformat{\subsubsection}
  {\fontsize{11}{13}\bfseries}{\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{2pt}{2pt}

% Level-3 (paragraph) — marked with * per HNUE
\titleformat{\paragraph}[runin]
  {\fontsize{11}{13}\itshape\bfseries}{*}{0.5em}{}
\titlespacing*{\paragraph}{0.75cm}{2pt}{0.5em}

% --- Caption style ------------------------------------------------------------
\captionsetup{aboveskip=3pt, belowskip=3pt}                           % tighten whitespace around captions
\captionsetup[table]{position=top,    font={bf,it}, justification=centering, labelsep=period, name=Bảng}
\captionsetup[figure]{position=bottom, font={bf,it}, justification=centering, labelsep=period, name=Hình}

% --- Shortcuts ----------------------------------------------------------------
\newcommand{\thetahat}{\hat{\theta}}
\newcommand{\thetait}{\theta_{it}}
\newcommand{\seit}{\mathrm{SE}_{it}}
\newcommand{\Var}{\mathrm{Var}}
\newcommand{\Norm}{\mathcal{N}}
\newcommand{\IRT}{IRT}
\newcommand{\LSEM}{LSEM}
\newcommand{\CTDSEM}{CT-DSEM}
\newcommand{\OLM}{OLM}
\newcommand{\KFAS}{KFAS}
\newcommand{\Rasch}{Rasch}
\newcommand{\EAP}{EAP}

% --- Compact list spacing (paper economy on 10-page limit) --------------------
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.2em}

\endinput
